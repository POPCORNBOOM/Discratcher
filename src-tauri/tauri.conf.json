{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discratcher",
  "version": "0.1.1",
  "identifier": "dev.popcornboom.discratcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discratcher",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#1E1E1E",
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}